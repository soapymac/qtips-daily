# ---------------------------------------------------------------------------
# JD Grounds — environment variables
# Copy to .env.local for local dev, or set these in Vercel > Project > Settings.
# All values are optional; the site builds and runs without any of them.
# ---------------------------------------------------------------------------

# Public URL of the deployed site (no trailing slash). Used for canonical
# links, sitemap.xml, robots.txt and Open Graph tags. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://jd-grounds.vercel.app

# Quote form endpoint. If set, the form POSTs JSON here (Formspree, Basin,
# Getform, a Netlify/Vercel function, etc). If unset, the form falls back to
# opening a pre-filled email to jdouqa@hotmail.co.uk.
# Formspree example: https://formspree.io/f/xxxxxxxx
# NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics (optional). Set ONE of these to enable; the script tag is only
# rendered when a value is present.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=jd-grounds.vercel.app
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
